{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:researchwitness:tabular-summary-check:0.1",
  "title": "ResearchWitness exact tabular-summary check 0.1",
  "description": "Exact univariate descriptive-statistic recomputation from supplied rational values or a bounded local CSV/TSV column. File extraction selects one column and applies an explicit missing-value policy; arbitrary filtering, grouping, and transformations are not performed.",
  "type": "object",
  "properties": {
    "summary_check_version": {
      "enum": [
        "0.1"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "text_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "capture_status": {
          "enum": [
            "unverified",
            "captured",
            "synthetic"
          ]
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "quote_offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      },
      "required": [
        "identifier",
        "version",
        "text_file",
        "capture_status",
        "quote"
      ],
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "properties": {
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "data_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "transformation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 130,
            "pattern": "^-?(?:0|[1-9][0-9]{0,63})(?:/[1-9][0-9]{0,63})?$"
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "file": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "format": {
                  "enum": [
                    "csv",
                    "tsv"
                  ]
                },
                "header": {
                  "const": true
                },
                "column_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "missing_values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "missing_policy": {
                  "enum": [
                    "reject",
                    "drop"
                  ]
                }
              },
              "required": [
                "path",
                "format",
                "header",
                "column_name",
                "missing_values",
                "missing_policy"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "format": {
                  "enum": [
                    "csv",
                    "tsv"
                  ]
                },
                "header": {
                  "const": false
                },
                "column_index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "missing_values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "minItems": 0,
                  "maxItems": 32,
                  "uniqueItems": true
                },
                "missing_policy": {
                  "enum": [
                    "reject",
                    "drop"
                  ]
                }
              },
              "required": [
                "path",
                "format",
                "header",
                "column_index",
                "missing_values",
                "missing_policy"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "column",
        "data_source",
        "transformation"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "values"
          ],
          "not": {
            "required": [
              "file"
            ]
          }
        },
        {
          "required": [
            "file"
          ],
          "not": {
            "required": [
              "values"
            ]
          }
        }
      ]
    },
    "reported": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "statistic": {
                "enum": [
                  "count"
                ]
              },
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4096
              },
              "tolerance": {
                "type": "string",
                "maxLength": 130,
                "pattern": "^-?(?:0|[1-9][0-9]{0,63})(?:/[1-9][0-9]{0,63})?$"
              }
            },
            "required": [
              "statistic",
              "value",
              "tolerance"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "statistic": {
                "enum": [
                  "sum",
                  "mean",
                  "median",
                  "minimum",
                  "maximum",
                  "sample_variance",
                  "population_variance"
                ]
              },
              "value": {
                "type": "string",
                "maxLength": 130,
                "pattern": "^-?(?:0|[1-9][0-9]{0,63})(?:/[1-9][0-9]{0,63})?$"
              },
              "tolerance": {
                "type": "string",
                "maxLength": 130,
                "pattern": "^-?(?:0|[1-9][0-9]{0,63})(?:/[1-9][0-9]{0,63})?$"
              }
            },
            "required": [
              "statistic",
              "value",
              "tolerance"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "summary_check_version",
    "source",
    "data",
    "reported"
  ],
  "additionalProperties": false,
  "$defs": {
    "rational": {
      "type": "string",
      "maxLength": 130,
      "pattern": "^-?(?:0|[1-9][0-9]{0,63})(?:/[1-9][0-9]{0,63})?$"
    }
  }
}
