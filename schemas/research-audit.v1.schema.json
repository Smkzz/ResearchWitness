{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detector_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "object"
    },
    "document": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "maxLength": 10000,
          "type": "string"
        },
        "expected_hash_verified": {
          "type": "boolean"
        },
        "input_format": {
          "enum": [
            "jats",
            "pdf"
          ]
        },
        "provenance_authenticated_by_tool": {
          "const": false
        },
        "provenance_status": {
          "maxLength": 10000,
          "type": "string"
        },
        "source_bytes": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "source_url": {
          "maxLength": 10000,
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source_sha256",
        "source_bytes",
        "input_format",
        "source_url",
        "provenance_status",
        "provenance_authenticated_by_tool",
        "expected_hash_verified"
      ],
      "type": "object"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "maxLength": 10000,
            "type": "string"
          },
          "relationship": {
            "properties": {
              "denominator": {
                "anyOf": [
                  {
                    "maximum": 999999999,
                    "minimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "evidence": {
                "properties": {
                  "source_sha256": {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  }
                },
                "required": [
                  "source_sha256"
                ],
                "type": "object"
              },
              "numerator": {
                "maximum": 999999999,
                "minimum": 0,
                "type": "integer"
              },
              "reason": {
                "anyOf": [
                  {
                    "maxLength": 10000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reported_percent": {
                "pattern": "^[0-9]{1,3}(\\.[0-9]{1,6})?$",
                "type": "string"
              },
              "status": {
                "maxLength": 10000,
                "type": "string"
              }
            },
            "required": [
              "status",
              "reason",
              "numerator",
              "denominator",
              "reported_percent",
              "evidence"
            ],
            "type": "object"
          },
          "review_state": {
            "const": "unreviewed"
          },
          "scientific_error_status": {
            "const": "not_established"
          },
          "state": {
            "enum": [
              "extracted_evidence",
              "arithmetic_match",
              "arithmetic_mismatch_candidate"
            ]
          }
        },
        "required": [
          "finding_id",
          "state",
          "review_state",
          "scientific_error_status",
          "relationship"
        ],
        "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 10000,
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "processing": {
      "additionalProperties": false,
      "properties": {
        "extracted_text_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "extraction_profile": {
          "maxLength": 10000,
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "relationships_detected": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "enum": [
            "completed",
            "extraction_failed"
          ]
        },
        "tables_inspected": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "status",
        "reason",
        "tables_inspected",
        "relationships_detected",
        "extracted_text_sha256",
        "extraction_profile"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "research-audit.v1"
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "abstentions": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        },
        "arithmetic_matches": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        },
        "conditional_mismatches": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        },
        "mismatch_candidates": {
          "maximum": 999999999,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "arithmetic_matches",
        "mismatch_candidates",
        "abstentions",
        "conditional_mismatches"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "document",
    "detector_files",
    "processing",
    "summary",
    "findings",
    "limitations"
  ],
  "type": "object"
}
