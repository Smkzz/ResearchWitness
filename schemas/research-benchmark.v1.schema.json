{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_count": {
      "maximum": 999999999,
      "minimum": 0,
      "type": "integer"
    },
    "annotation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "document_count": {
      "maximum": 999999999,
      "minimum": 0,
      "type": "integer"
    },
    "exposure": {
      "const": "development"
    },
    "limitations": {
      "items": {
        "maxLength": 10000,
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "runs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "abstentions_by_reason": {
            "additionalProperties": {
              "maximum": 999999999,
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "detector_files": {
            "additionalProperties": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "type": "object"
          },
          "detector_revision": {
            "maxLength": 10000,
            "type": "string"
          },
          "documents": {
            "items": {
              "type": "object"
            },
            "maxItems": 100,
            "type": "array"
          },
          "error_taxonomy": {
            "additionalProperties": {
              "maximum": 999999999,
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "label": {
            "maxLength": 10000,
            "type": "string"
          },
          "metrics": {
            "additionalProperties": {
              "maximum": 999999999,
              "minimum": 0,
              "type": "integer"
            },
            "type": "object"
          },
          "relationships": {
            "items": {
              "type": "object"
            },
            "maxItems": 20000,
            "type": "array"
          },
          "unannotated_outputs": {
            "items": {
              "type": "object"
            },
            "maxItems": 10000,
            "type": "array"
          }
        },
        "required": [
          "label",
          "detector_revision",
          "detector_files",
          "metrics",
          "abstentions_by_reason",
          "error_taxonomy",
          "documents",
          "relationships",
          "unannotated_outputs"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "research-benchmark.v1"
    },
    "work_family_count": {
      "maximum": 999999999,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "exposure",
    "annotation_sha256",
    "document_count",
    "work_family_count",
    "annotation_count",
    "runs",
    "limitations"
  ],
  "type": "object"
}
