        "methods_design",
        "code_reproducibility",
        "figures_tables",
        "interpretation",
        "ethics_reporting"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "area": {
            "enum": [
              "source_citations",
              "internal_consistency",
              "mathematics_logic",
              "statistics_quantitative",
              "data_integrity",
              "methods_design",
              "code_reproducibility",
              "figures_tables",
              "interpretation",
              "ethics_reporting"
            ]
          },
          "status": {
            "enum": [
              "candidate",
              "dismissed",
              "formalization_replay",
              "tabular_summary_replay",
              "unsupported"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "evidence_files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "minItems": 0,
            "maxItems": 32,
            "uniqueItems": true
          },
          "quote_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777216
          },
          "verification_bundle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "summary_check": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "area",
          "status",
          "location",
          "statement",
          "quote",
          "rationale",
          "evidence_files"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "formalization_replay"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "verification_bundle"
              ],
              "not": {
                "required": [
                  "summary_check"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "tabular_summary_replay"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "summary_check"
              ],
              "not": {
                "required": [
                  "verification_bundle"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "candidate",
                    "unsupported",
                    "dismissed"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "verification_bundle"
                    ]
                  },
                  {
                    "required": [
                      "summary_check"
                    ]
                  }
                ]
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "review_version",
    "review_id",
    "reviewed_on",
    "source",
    "areas",
    "findings"
  ],
  "additionalProperties": false
}
