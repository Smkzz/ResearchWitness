{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:researchwitness:paper-review:0.1",
  "title": "ResearchWitness broad paper-review ledger 0.1",
  "description": "Structural schema for a multi-area research-paper review. Candidate observations are unverified; the Python validator checks source quote anchors, local evidence files, and linked checker replays.",
  "type": "object",
  "properties": {
    "review_version": {
      "enum": [
        "0.1"
      ]
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "reviewed_on": {
      "type": "string",
      "format": "date",
      "minLength": 10,
      "maxLength": 10
    },
    "source": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "text_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "capture_status": {
          "enum": [
            "unverified",
            "captured",
            "synthetic"
          ]
        }
      },
      "required": [
        "identifier",
        "version",
        "text_file",
        "capture_status"
      ],
      "additionalProperties": false
    },
    "areas": {
      "type": "object",
      "properties": {
        "source_citations": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "findings_recorded",
                "not_applicable",
                "not_reviewed",
                "reviewed_no_findings",
                "unsupported"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "notes": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "evidence_files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "minItems": 0,
              "maxItems": 32,
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "method",
            "notes",
            "evidence_files"
          ],
          "additionalProperties": false
        },
