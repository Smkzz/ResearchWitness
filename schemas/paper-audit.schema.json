{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:researchwitness:paper-audit-report:0.1",
  "title": "ResearchWitness bounded paper-screening report 0.1",
  "description": "A bounded local scan for conflicting explicit n/N integer markers. Candidate anomalies are not verified errors; a negative result covers only the supported extracted-text scan.",
  "type": "object",
  "properties": {
    "paper_audit_version": {
      "enum": [
        "0.1"
      ]
    },
    "decision": {
      "enum": [
        "CANDIDATES_FOUND",
        "CANDIDATES_FOUND_IN_INCOMPLETE_SCAN",
        "NO_CANDIDATES_IN_SUPPORTED_SCAN",
        "SCAN_INCOMPLETE_NO_CANDIDATES",
        "EXTRACTION_UNAVAILABLE_OR_EMPTY"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "capture_status": {
          "enum": [
            "unverified"
          ]
        },
        "source_file": {
          "enum": [
            "source.txt",
            "source.md",
            "source.markdown",
            "source.pdf"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "identifier",
        "version",
        "capture_status",
        "source_file",
        "sha256"
      ],
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "TEXT_AVAILABLE",
            "PARTIAL_TEXT",
            "NO_EXTRACTABLE_TEXT",
            "PARSER_UNAVAILABLE",
            "MALFORMED_OR_UNSUPPORTED",
            "LIMIT_OR_UNSUPPORTED"
          ]
        },
        "extractor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "original_format": {
          "enum": [
            "txt",
            "md",
            "markdown",
            "pdf"
          ]
        },
        "source_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "text_file": {
          "enum": [
            "extracted-text.txt"
          ]
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "text_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "page_count": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          ]
        },
        "page_map": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "page_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "character_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 524288
              },
              "status": {
                "enum": [
                  "TEXT_EXTRACTED",
                  "NO_EXTRACTABLE_TEXT"
                ]
              },
              "text_start_byte": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              },
              "text_end_byte": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              }
            },
            "required": [
              "page_number",
              "character_count",
              "status",
              "text_start_byte",
              "text_end_byte"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 500
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "minItems": 0,
          "maxItems": 16
        },
        "ocr_performed": {
          "const": false
        }
      },
      "required": [
        "status",
        "extractor",
        "original_format",
        "source_bytes",
        "text_file",
        "text_sha256",
        "text_bytes",
        "page_count",
        "page_map",
        "warnings",
        "ocr_performed"
      ],
      "additionalProperties": false
    },
    "paper_structure": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "maxLength": 2000
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6
              },
              "start_byte": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              },
              "line_number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            },
            "required": [
              "heading",
              "level",
              "start_byte",
              "line_number"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 512
        },
        "layout_status": {
          "enum": [
            "TEXT_OR_MARKDOWN_OFFSETS",
            "PDF_PAGE_AND_EXTRACTED_TEXT_OFFSETS_ONLY"
          ]
        }
      },
      "required": [
        "sections",
        "layout_status"
      ],
      "additionalProperties": false
    },
    "discovery": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "deterministic_local_heuristic"
          ]
        },
        "discoverer": {
          "enum": [
            "explicit_count_marker_scan"
          ]
        },
        "scan_complete": {
          "type": "boolean"
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^count-[0-9]{4}$"
              },
              "kind": {
                "enum": [
                  "explicit_count_marker"
                ]
              },
              "marker": {
                "enum": [
                  "n",
                  "N"
                ]
              },
              "surface_value": {
                "type": "string",
                "pattern": "^[0-9]{1,9}$"
              },
              "value_exact": {
                "type": "string",
                "pattern": "^(?:0|[1-9][0-9]{0,8})$"
              },
              "anchor": {
                "type": "object",
                "properties": {
                  "text_file": {
                    "enum": [
                      "extracted-text.txt"
                    ]
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 75
                  },
                  "start_byte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 33554432
                  },
                  "end_byte": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 33554432
                  },
                  "line_number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 33554432
                  },
                  "context": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "page_number": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 500
                  },
                  "page_offset_start_byte": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 524288
                  },
                  "page_offset_end_byte": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 524288
                  },
                  "section": {
                    "type": "string",
                    "maxLength": 2000
                  }
                },
                "required": [
                  "text_file",
                  "quote",
                  "start_byte",
                  "end_byte",
                  "line_number",
                  "context"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "kind",
              "marker",
              "surface_value",
              "value_exact",
              "anchor"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 512
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "provider",
        "discoverer",
        "scan_complete",
        "assertions",
        "limitations"
      ],
      "additionalProperties": false
    },
    "candidate_anomalies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^conflicting-[nN]-values$"
          },
          "type": {
            "enum": [
              "CONFLICTING_EXPLICIT_COUNT_MARKERS"
            ]
          },
          "status": {
            "enum": [
              "CANDIDATE_ANOMALY"
            ]
          },
          "marker": {
            "enum": [
              "n",
              "N"
            ]
          },
          "values_exact": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]{0,8})$"
            },
            "minItems": 2,
            "maxItems": 512
          },
          "assertion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^count-[0-9]{4}$"
            },
            "minItems": 2,
            "maxItems": 512
          },
          "source_anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text_file": {
                  "enum": [
                    "extracted-text.txt"
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 75
                },
                "start_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 33554432
                },
                "end_byte": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 33554432
                },
                "line_number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 33554432
                },
                "context": {
                  "type": "string",
                  "maxLength": 2000
                },
                "page_number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                },
                "page_offset_start_byte": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 524288
                },
                "page_offset_end_byte": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 524288
                },
                "section": {
                  "type": "string",
                  "maxLength": 2000
                }
              },
              "required": [
                "text_file",
                "quote",
                "start_byte",
                "end_byte",
                "line_number",
                "context"
              ],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 512
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "required_review": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "marker",
          "values_exact",
          "assertion_ids",
          "source_anchors",
          "interpretation",
          "required_review"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "checks_attempted": {
      "type": "array",
      "items": {
        "enum": [
          "explicit_count_marker_scan"
        ]
      },
      "minItems": 0,
      "maxItems": 1
    },
    "verified_findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0,
      "maxItems": 0
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 0,
      "maxItems": 256
    },
    "unsupported_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "maxItems": 16
    },
    "known_corrections": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "NOT_CHECKED"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "paper_error_established": {
      "const": false
    },
    "meaning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  },
  "required": [
    "paper_audit_version",
    "decision",
    "source",
    "extraction",
    "paper_structure",
    "discovery",
    "candidate_anomalies",
    "checks_attempted",
    "verified_findings",
    "unresolved_questions",
    "unsupported_checks",
    "known_corrections",
    "paper_error_established",
    "meaning"
  ],
  "additionalProperties": false
}
