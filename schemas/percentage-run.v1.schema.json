{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detector_files": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 10,
      "minProperties": 1,
      "type": "object"
    },
    "detector_revision": {
      "maxLength": 10000,
      "type": "string"
    },
    "documents": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "maxLength": 10000,
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_path": {
            "anyOf": [
              {
                "maxLength": 10000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "report_sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "status": {
            "enum": [
              "analyzed",
              "extraction_failed"
            ]
          }
        },
        "required": [
          "document_id",
          "source_sha256",
          "status",
          "report_path",
          "report_sha256",
          "reason"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "label": {
      "maxLength": 10000,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "label",
    "detector_revision",
    "detector_files",
    "documents"
  ],
  "type": "object"
}
