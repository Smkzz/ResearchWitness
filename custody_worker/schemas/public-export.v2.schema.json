{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_commitment", "public_summary"],
  "properties": {
    "schema_version": {"const": "rw-custody-public-export/2"},
    "inventory_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "eligible_positive_cases", "eligible_negative_relationships",
        "distinct_negative_document_ids", "minimum_count_thresholds_met",
        "inventory_sealed", "integrity_commitment", "meaning"
      ],
      "properties": {
        "schema_version": {"const": "rw-custody-public-summary/2"},
        "eligible_positive_cases": {"enum": ["AT_LEAST_1", "BELOW_1"]},
        "eligible_negative_relationships": {"enum": ["AT_LEAST_50", "BELOW_50"]},
        "distinct_negative_document_ids": {"enum": ["AT_LEAST_15", "BELOW_15"]},
        "minimum_count_thresholds_met": {"type": "boolean"},
        "inventory_sealed": {"const": true},
        "integrity_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "meaning": {"type": "string", "maxLength": 240}
      }
    }
  }
}
