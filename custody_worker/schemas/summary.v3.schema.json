{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "import_batches", "import_files", "source_documents", "source_versions", "reviews", "eligible_positive_issues", "eligible_positive_relations", "eligible_negative_relations", "eligible_negative_document_ids", "eligible_negative_tables", "eligible_negative_versions", "arithmetic_mismatches", "unresolved", "ineligible", "meaning", "seal_count", "current_inventory_sealed", "current_seal_commitment"],
  "properties": {
    "schema_version": {"const": "rw-custody-summary/3"},
    "import_batches": {"type": "integer", "minimum": 0},
    "import_files": {"type": "integer", "minimum": 0},
    "source_documents": {"type": "integer", "minimum": 0},
    "source_versions": {"type": "integer", "minimum": 0},
    "reviews": {"type": "integer", "minimum": 0},
    "eligible_positive_issues": {"type": "integer", "minimum": 0},
    "eligible_positive_relations": {"type": "integer", "minimum": 0},
    "eligible_negative_relations": {"type": "integer", "minimum": 0},
    "eligible_negative_document_ids": {"type": "integer", "minimum": 0},
    "eligible_negative_tables": {"type": "integer", "minimum": 0},
    "eligible_negative_versions": {"type": "integer", "minimum": 0},
    "arithmetic_mismatches": {"type": "integer", "minimum": 0},
    "unresolved": {"type": "integer", "minimum": 0},
    "ineligible": {"type": "integer", "minimum": 0},
    "meaning": {"type": "string"},
    "seal_count": {"type": "integer", "minimum": 0},
    "current_inventory_sealed": {"type": "boolean"},
    "current_seal_commitment": {"anyOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}
  }
}
