{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source_url", "retrieved_at_utc", "license_notice", "public_use_status"],
      "properties": {
        "method": {"enum": ["APPROVED_PUBLIC_PROVIDER", "HASH_PINNED_HANDOFF", "SYNTHETIC_FIXTURE"]},
        "source_url": {"type": "string", "minLength": 1, "maxLength": 2048},
        "retrieved_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "license_notice": {"type": "string", "minLength": 1, "maxLength": 512},
        "public_use_status": {"enum": ["CUSTODIAN_CONFIRMED_PUBLIC_USE", "NOT_APPLICABLE_SYNTHETIC"]}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "SYNTHETIC_FIXTURE"}}, "required": ["method"]},
          "then": {
            "properties": {
              "source_url": {"pattern": "^synthetic://fixture/"},
              "public_use_status": {"const": "NOT_APPLICABLE_SYNTHETIC"}
            }
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["APPROVED_PUBLIC_PROVIDER", "HASH_PINNED_HANDOFF"]}}, "required": ["method"]},
          "then": {
            "properties": {
              "source_url": {"pattern": "^https://(api\\.crossref\\.org|www\\.ebi\\.ac\\.uk|eutils\\.ncbi\\.nlm\\.nih\\.gov|pmc\\.ncbi\\.nlm\\.nih\\.gov)(:443)?(/|\\?|$)"},
              "public_use_status": {"const": "CUSTODIAN_CONFIRMED_PUBLIC_USE"}
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "files"],
  "properties": {
    "schema_version": {"const": "rw-custody-import/2"},
    "batch_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "role", "size", "sha256", "document_id", "source_id", "source_version", "provenance"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$"},
          "role": {"enum": ["original", "correction", "supplement"]},
          "size": {"type": "integer", "minimum": 1, "maximum": 33554432},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "document_id": {"type": "string", "pattern": "^doi:10\\.[0-9]{4,9}/[^\\s<>?#]+$"},
          "source_id": {"type": "string", "pattern": "^(doi:10\\.[0-9]{4,9}/[^\\s<>?#]+|pmid:[0-9]+|pmcid:PMC[0-9]+)$"},
          "source_version": {"type": "string", "minLength": 1, "maxLength": 160},
          "provenance": {"$ref": "#/$defs/provenance"}
        }
      }
    }
  }
}
